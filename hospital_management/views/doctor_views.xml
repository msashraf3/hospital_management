<odoo>

    <!-- list view -->
    <record id="hospital_doctor_list_view" model="ir.ui.view">
        <field name="name">hospital.doctor.tree</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctor">
                <field name="name" />
                <field name="specialization" />
                <field name="phone" />
                <field name="department" />
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="hospital_doctor_form_view" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="age" />
                        <field name="gender" />
                        <field name="date_of_birth" />
                        <field name="specialization" />
                        <field name="department" />
                        <field name="phone" />
                        <field name="email" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- action -->
    <record id="hospital_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctor</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hospital_root" name="Hospital Management" />
    <menuitem id="menu_hospital_doctor" name="Doctors" parent="menu_hospital_root" action="hospital_doctor_action" sequence="10"/>

</odoo>