<odoo>

    <!-- list view -->
    <record id="hospital_appointment_list_view" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointment">
                <field name="patient_id" />
                <field name="doctor_id" />
                <field name="severity" />
                <field name="status" />
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="hospital_appointment_form_view" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">

                <header>
                    <button name="action_confirm" type="object" string="Confirm The Appointment"
                        class="btn-primary" invisible="status !='draft' or not id" />
                    <button name="action_done" type="object" string="Mark it as DONE"
                        class="btn-success" invisible="status !='confirmed' or not id" />
                    <button name="action_cancel" type="object" string="Cancel The Appointment"
                        class="btn-warning" invisible="status in ('cancelled','done') or not id" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_doctors" type="object" class="oe_stat_button"
                            icon="fa-user" string="Assigned Doctor" invisible="not id">
                        </button>
                        <button name="action_view_patients" type="object" class="oe_stat_button"
                            icon="fa-user" string="Assigned Patients" invisible="not id">
                        </button>
                    </div>
                    <group>
                        <field name="patient_id" />
                        <field name="doctor_id" />
                        <field name="appointment_date" />
                        <field name="reason" />
                        <field name="severity" />
                        <field name="is_contagious" />
                        <field name="status" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- kanban view-->

    <record id="hospital_appointment_view_kanban" model="ir.ui.view">
        <field name="name">hospital.appointment.kanban</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">

            <kanban>

                <field name="patient_id" />
                <field name="doctor_id" />
                <field name="appointment_date" />
                <field name="severity" />
                <field name="status" />

                <templates>

                    <t t-name='card' class='rounded-4'>

                        <div class='oe-kanban-card rounded shadow-sm p-3'>

                            <strong>
                                <field name='patient_id' />
                            </strong>

                            <br />

                            <span
                                class="text-warning">Doctor:</span>
                            <field name='doctor_id' />

                            <br />
                            Severity: <field name='severity' />

                            <br /> Date: <field
                                name='appointment_date' />

                            <br /> Status: <field name='status' />

                        </div>


                    </t>

                </templates>

            </kanban>

        </field>
    </record>

    <!-- search view -->
    <record id="hospital_appointment_search_view" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">

            <!-- search fields -->
            <search string="Search Appointment">
                <field name="patient_id" />
                <field name="doctor_id" />
                <field name="severity" />

                <!-- filter feature -->
                <filter
                    string='Draft'
                    name='draft'
                    domain="[('status', '=', 'draft')]"
                />

                <filter
                    string='Confirmed'
                    name='confirmed'
                    domain="[('status', '=', 'confirmed')]"
                />

                <filter
                    string='Cancelled'
                    name='cancelled'
                    domain="[('status', '=', 'cancelled')]"
                />

                <!-- group by -->

                <group>

                    <filter
                        string="Doctor"
                        name="group_doctor"
                        context="{'group_by':'doctor_id'}"
                    />

                    <filter
                        string="Severity"
                        name="group_severity"
                        context="{'group_by':'severity'}"
                    />

                </group>

            </search>

        </field>
    </record>

    <!-- action -->
    <record id="hospital_appointment_action" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
    </record>

    <!-- menu -->
    <menuitem id="menu_hospital_appointment" name="Appointment" parent="menu_hospital_root"
        action="hospital_appointment_action" />

</odoo>