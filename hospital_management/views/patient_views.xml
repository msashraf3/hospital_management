<odoo>
    <!-- List View -->
    <record id="hospital_patient_tree_view" model="ir.ui.view">
        <field name="name">hospital.patient.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name" />
                <field name="age" />
                <field name="gender" />
                <field name="doctor_id" />
                <field name="phone" />
            </list>
        </field>
    </record>


    <!-- search View -->
    <record id="hospital_patient_search_form" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">

            <!-- search fields -->
            <search string='Patient Search'>
                <field name="name" />
                <field name="age" />
                <field name="gender" />

                <!-- group by fields -->
                <filter
                    string="Gender"
                    name="group_gender"
                    context="{'group_by':'gender'}"
                />

            </search>

        </field>
    </record>

    <!-- kanban View -->
    <record id="hospital_patient_kanban_form" model="ir.ui.view">
        <field name="name">hospital.patient.kanban</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">

            <kanban>
                <field name="name" />
                <field name="age" />
                <field name="gender" />
                <field name="doctor_id" />
                <field name="phone" />
                <field name="medical_history" />
                <templates>
                    <t t-name="card" class="rounded-4">
                        <div class="oe-kanban-card rounded shadow-sm p-3">
                            <strong>
                                <field name='name'/>
                            </strong>
                            <br/>
                            Age:
                            <fields name="age"/>
                            <br />
                            Gender:
                            <fields name="gender"/>
                            <br />
                            Assigned Doctor:
                            <fields name="doctor_id"/>
                            <br />
                            Phone:
                            <fields name="phone"/>
                            <br />
                            Medical History:
                            <fields name="medical_history"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="hospital_patient_view_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="age" />
                        <field name="gender" />
                        <field name="doctor_id" />
                        <field name="phone" />
                        <field name="medical_history" />
                    </group>
                    <notebook>
                        <page string="Doctor Appointments">
                            <field name="appointment_ids">
                                <list>
                                    <field name="doctor_id" />
                                    <field name="appointment_date" />
                                    <field name="status" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_hospital_patient" name="Patients" parent="menu_hospital_root"
        action="hospital_patient_action" sequence="20" />
</odoo>