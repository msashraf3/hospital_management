<odoo>
    <record id="rule_appointment_doctor_own" model="ir.rule">
        <field name="name">Doctor sees only their own appointments.</field>
        <field name="model_id" ref="model_hospital_appointment" />
        <field name="groups" eval="[(6, 0, [ref('group_hospital_doctor')])]"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
    </record>

</odoo>